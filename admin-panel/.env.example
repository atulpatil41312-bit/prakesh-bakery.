MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@prakashbakery.test"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
